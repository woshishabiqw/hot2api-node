# AI Key Gateway - Nginx unified entry (non-Docker)
# Generated from config/server.json via scripts/generate-nginx-conf.js
# DO NOT EDIT THIS FILE DIRECTLY; edit the template and rerun generation.

worker_processes  1;
pid               nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout  65;
    client_max_body_size 50m;

${SERVER_TOKENS}
${CLIENT_TIMEOUTS}
${RATE_LIMIT_ZONE}

    # Upstreams are read from config/server.json
    upstream backend_api {
        server 127.0.0.1:${API_PORT};
    }

    upstream frontend_admin {
        server 127.0.0.1:${ADMIN_PORT};
    }

    upstream frontend_user {
        server 127.0.0.1:${USER_PORT};
    }

    # Proxy settings for streaming API endpoints (kept in a map-like include is not
    # needed here; duplicated intentionally to keep the generated file self-contained)

    # User portal: ${NGINX_USER_LISTEN}
    server {
        listen       ${NGINX_USER_LISTEN};
        server_name  ${NGINX_SERVER_NAME};

${SECURITY_HEADERS_BLOCK}

        location /api/ {
            proxy_pass http://backend_api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_cache off;
${RATE_LIMIT_DIRECTIVE}
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 300s;
        }

        # OpenAI-compatible API key endpoints
        location /v1/ {
            proxy_pass http://backend_api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_cache off;
${RATE_LIMIT_DIRECTIVE}
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 300s;
        }

        # Gemini-compatible API key endpoints
        location /v1beta/ {
            proxy_pass http://backend_api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_cache off;
${RATE_LIMIT_DIRECTIVE}
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 300s;
        }

        # Anthropic-compatible API key endpoints
        location /anthropic/ {
            proxy_pass http://backend_api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_cache off;
${RATE_LIMIT_DIRECTIVE}
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 300s;
        }

        location / {
            proxy_pass http://frontend_user/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   html;
        }
    }

    # Admin portal: ${NGINX_ADMIN_LISTEN}
    server {
        listen       ${NGINX_ADMIN_LISTEN};
        server_name  ${NGINX_SERVER_NAME};

${SECURITY_HEADERS_BLOCK}
${ADMIN_IP_ALLOW_BLOCK}

        location /api/ {
            proxy_pass http://backend_api/;
            proxy_set_header Host $host;
