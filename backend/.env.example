# Server
PORT=3000
ADMIN_PORT=3001
USER_PORT=3002
NODE_ENV=development

# Security (MUST change in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-32-character-encryption-key
SECOND_AUTH_SECRET=your-second-auth-secret-change-in-production
# SECURITY: PIN required to initialize the database from the admin UI. Must be exactly 6 digits.
INIT_DATABASE_PIN=

# Database (PostgreSQL only)
DATABASE_URL=postgresql://user:password@localhost:5432/gateway

# Redis (Phase 1)
# REDIS_URL=redis://localhost:6379

# Defaults
DEFAULT_ADMIN_USERNAME=admin
# SECURITY: no hard-coded default password. Set a strong password here or via environment.
DEFAULT_ADMIN_PASSWORD=

# Registration
# Set to false to disable user self-registration. Empty or unset means enabled.
ALLOW_REGISTRATION=

# Logging
LOG_LEVEL=info

# Alipay Sandbox (optional; leave empty to use mock payment)
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
API_BASE_URL=http://localhost:3000
